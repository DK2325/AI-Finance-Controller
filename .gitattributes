# LF everywhere, authoritatively.
#
# The generator emits LF and asserts byte-identical output for a given seed. If git
# checked the data files out as CRLF on Windows, freshly generated data would differ
# from committed data by every line ending, and the determinism exit criterion would
# fail on a reviewer's machine while passing on ours. .gitattributes is used rather
# than core.autocrlf because it travels with the repo.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.pdf binary

# Shell scripts must stay LF or the Linux containers cannot execute them.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf
