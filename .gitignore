venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.env
node_modules/
.next/
*.log

# Working run artifacts. Regenerable, and predictions.jsonl is large and churny.
# The three canonical runs live in notes/runs/ as curve.json + report.json + chart.png:
#   baseline    Phase 2 regression floor
#   v1          Phase 4 calibrated model
#   sealed-test Phase 7
# Leading slash anchors this to the repo root -- a bare "runs/" would also match
# notes/runs/, silently excluding the committed canonical artifacts.
#
# The trailing "*" is load-bearing and was missing until Phase 7. "/runs/" excludes the
# DIRECTORY, and git will not descend into an excluded directory, so every "!" exception
# below it was inert -- v1-train and _models were surviving only because they had been
# added to the index before the rule existed, not because the exception worked. That went
# unnoticed for five phases because the outcome looked right. "/runs/*" excludes the
# contents instead, which git can re-include from.
/runs/*

# Two exceptions, because they are deliverables rather than scratch.
#
# The hosted demo must come up seeded with a completed run, on a cold boot, with no
# training and no database write -- "live public URL, seeded with a completed run" is an
# exit criterion, and a cold start that trains a model is the thing that fails in front of
# a panel. So the trained artifact and one scored run are versioned. 2.4 MB together.
!/runs/_models/
!/runs/_models/**
!/runs/v1-train/
!/runs/v1-train/**

# The sealed-test run. Committed for the same reason v1-train is -- the deployed image
# seeds from the repository, and this is the run the submission's headline numbers come
# from. Before Phase 7 no run over data/test could exist; now that the seal is broken,
# keeping it out would mean the live demo shows a superseded operating point.
!/runs/v1-test/
!/runs/v1-test/**

# Still ignored: /runs/_datasets/ (regenerable intermediates), /runs/_llm_cache/, and
# every ad-hoc run.
/runs/_datasets/
/runs/_llm_cache/

# The Phase 7 scale batch: 25,000 settlements, ~11 MB, generated by
#   ledgerloop generate --rows 25000 --seed 2026 --out data/scale
# The manifest records the seed and the case counts, so the batch is reproducible from
# them rather than being a deliverable. data/demo, data/train and data/test stay tracked.
data/scale/
