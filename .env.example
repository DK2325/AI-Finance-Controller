# Copy this file to .env and fill in your key. NEVER commit .env - it is gitignored.
#
#   copy .env.example .env
#
# Then edit .env and paste your key after NVIDIA_API_KEY=

# ---------------------------------------------------------------- LLM provider
# Required from Phase 5 onward. Every phase before it runs fully with --mock-llm,
# and --mock-llm keeps working after Phase 5 even when this is set.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ------------------------------------------------------------------- database
POSTGRES_USER=ledgerloop
POSTGRES_PASSWORD=ledgerloop
POSTGRES_DB=ledgerloop

# Host-side connection string (containers override this to host "db").
DATABASE_URL=postgresql+psycopg://ledgerloop:ledgerloop@localhost:5432/ledgerloop
