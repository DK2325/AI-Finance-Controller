# Copy to .env and fill in. Never commit a real key.

# Required from Phase 5 onward. Every phase before it runs with --mock-llm.
ANTHROPIC_API_KEY=

# Postgres credentials consumed by docker-compose.
POSTGRES_USER=ledgerloop
POSTGRES_PASSWORD=ledgerloop
POSTGRES_DB=ledgerloop

# Host-side connection string (containers override this to host "db").
DATABASE_URL=postgresql+psycopg://ledgerloop:ledgerloop@localhost:5432/ledgerloop
